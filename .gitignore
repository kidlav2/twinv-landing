# Merged from the two sides of the frontend/backend history. The previous
# version still contained raw <<<<<<< / ======= / >>>>>>> conflict markers,
# committed unresolved — git read those marker lines as patterns, so neither
# side's rules were fully in effect.
#
# The backend side also assumed a Vite frontend (frontend/.vite, frontend/dist).
# This is a Next.js app, so those are replaced with .next / out.

# ===== Node / Next.js (frontend/) =====
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/coverage/
next-env.d.ts
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ===== Python (backend/) =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.tox/
.ruff_cache/

# uv.lock is committed on purpose — do not ignore it.

# ===== Env =====
# Nothing carrying secrets, either side of the repo.
.env
.env.*
!.env.example
!**/.env.example

# ===== Deploy =====
.vercel

# ===== IDE =====
.idea/
.vscode/
*.iml

# ===== OS =====
.DS_Store
Thumbs.db
*.pem
