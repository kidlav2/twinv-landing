# Gmail API for brief notifications. All four are required together; leave
# them unset and briefs are only stored in SQLite. Values come from the
# one-time OAuth flow: uv run python scripts/get_google_refresh_token.py
TWINV_GOOGLE_CLIENT_ID=
TWINV_GOOGLE_CLIENT_SECRET=
TWINV_GOOGLE_REFRESH_TOKEN=
TWINV_MAIL_TO=

# Override the SQLite location if needed (defaults to backend/data/twinv.db).
# TWINV_DATABASE_URL=sqlite:///absolute/path/to/twinv.db
