# Gmail (Vercel production). Same TWINV_ names the backend already uses.
# The client id is required — a refresh token cannot be used without it.
TWINV_GOOGLE_CLIENT_ID=
TWINV_GOOGLE_CLIENT_SECRET=
TWINV_GOOGLE_REFRESH_TOKEN=
TWINV_MAIL_TO=
# Optional. The Gmail that authorised the refresh token. If omitted, the
# route asks Gmail for `users/me/profile` and uses that address as From.
TWINV_MAIL_FROM=

# FastAPI fallback. Optional in `next dev` — that already defaults to this
# URL when Gmail is not configured. Not needed on Vercel if Gmail is set.
# BRIEF_FORWARD_URL=http://127.0.0.1:8000/api/brief
